# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection String (Replace with your local URI or MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce_db

# JWT Secret & Expiration (Use a secure, randomly generated string in production)
JWT_SECRET=your_jwt_secret_key_here_at_least_32_characters
JWT_EXPIRE=30d

# Frontend Client URL (Allow CORS requests from your React development server)
CLIENT_URL=http://localhost:5174
